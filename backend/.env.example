PORT=5001
NODE_ENV=development

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=healthsync_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_SSL=false

# JWT Cryptographic Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key

# Redis Configuration (Supports local Redis, standard REDIS_URL, or Upstash REST)
REDIS_URL=redis://127.0.0.1:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Client Origin
FRONTEND_URL=http://localhost:3000

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# ------------------------------------------------------------------
# Phase 6 — AI Healthcare Assistant (Google Gemini via @google/genai)
# Backend only. NEVER put these in the frontend or use NEXT_PUBLIC_*.
# ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary model is overloaded/unavailable (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.3
AI_REQUEST_TIMEOUT_MS=30000
AI_REPORT_TIMEOUT_MS=90000
AI_MAX_RETRIES=2

# Usage limits
AI_DAILY_USER_LIMIT=20
AI_DAILY_REPORT_LIMIT=5
AI_RATE_LIMIT_PER_MINUTE=6
AI_MAX_INPUT_CHARS=4000
AI_CONTEXT_MESSAGES=10
AI_REPORT_MAX_MB=10

# RAG retrieval
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.65
RAG_KEYWORD_MIN_COVERAGE=0.5

# Optional Qdrant vector database (leave QDRANT_URL empty to use MySQL keyword fallback)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=healthsync_knowledge

# ------------------------------------------------------------------
# Phase 7 — Notification System, BullMQ & Background Jobs
# ------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=HealthSync AI <onboarding@resend.dev>

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@healthsync.ai

NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_PUSH_ENABLED=true
NOTIFICATION_SMS_ENABLED=false

QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=5

APPOINTMENT_REMINDER_HOURS=24
LAB_REMINDER_HOURS=12

APP_TIMEZONE=Asia/Kolkata

